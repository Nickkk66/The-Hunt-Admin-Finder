# .ROBLOSECURITY cookie from a logged-in roblox.com session.
# DevTools -> Application -> Cookies -> https://www.roblox.com -> .ROBLOSECURITY
# Copy the ENTIRE value, including the "_|WARNING:-DO-NOT-SHARE-THIS..." prefix.
# Anyone with this string is logged into your account, so never commit it.
ROBLOX_COOKIE=

# Discord webhook urls (Server Settings -> Integrations -> Webhooks -> Copy URL)
DISCORD_WEBHOOK_SILVER_WINGS=
DISCORD_WEBHOOK_GOLDEN_WINGS=

# Who gets pinged when someone NEW shows up (not on repeat alerts).
# Your Discord user id (Settings -> Advanced -> Developer Mode, then right-click
# yourself -> Copy User ID), role:<role id>, @here, or @everyone. Blank = no ping.
DISCORD_PING=

# debug | info | warn | error
LOG_LEVEL=info
